# Port on which the Express server listens
PORT=5000

# MongoDB Atlas or Local connection URI
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/finora?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_db_username:your_db_password@cluster.mongodb.net/finora?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Allowed frontend origin for CORS in production
CLIENT_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development

